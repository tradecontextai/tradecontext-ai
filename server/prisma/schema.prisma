// TradeContext.ai — Prisma schema
// Mirrors the SQL schema from TRADECONTEXT_BRIEFING.md §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── ENUMS ─────────────
enum Plan {
  free
  pro
  elite
}

enum PlanStatus {
  active
  cancelled
  past_due
  trialing
  incomplete
}

enum BrokerName {
  oanda
  binance
  bybit
  mt4
  mt5
  ibkr
  coinbase
  kraken
}

enum Direction {
  long
  short
}

enum Bias {
  bull
  bear
  neutral
}

enum Impact {
  high
  medium
  low
}

enum AlertCondition {
  above
  below
}

enum JournalEntryType {
  trade
  note
  mistake
  reflection
}

// ───────────── USERS ─────────────
model User {
  id                    String     @id @default(uuid())
  email                 String     @unique
  passwordHash          String     @map("password_hash")
  plan                  Plan       @default(free)
  planStatus            PlanStatus @default(active) @map("plan_status")
  stripeCustomerId      String?    @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?    @unique @map("stripe_subscription_id")
  emailVerified         Boolean    @default(false) @map("email_verified")
  emailVerifyToken      String?    @map("email_verify_token")
  passwordResetToken    String?    @map("password_reset_token")
  passwordResetExpires  DateTime?  @map("password_reset_expires")
  // Set when this user redeems a Lifetime checkout. Used to count remaining
  // lifetime spots (capped at 500 by marketing).
  lifetimeRedeemedAt    DateTime?  @map("lifetime_redeemed_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  brokerConnections BrokerConnection[]
  positions         Position[]
  trades            Trade[]
  journalEntries    JournalEntry[]
  playbooks         Playbook[]
  watchlist         WatchlistItem[]
  alerts            Alert[]
  fundedAccounts    FundedAccount[]
  brokerClicks      BrokerClick[]
  profile           UserProfile?
  chatMessages      AiChatMessage[]
  tradeIdeas        TradeIdea[]
  journalSyncTokens JournalSyncToken[]

  @@map("users")
}

// ───────────── JOURNAL SYNC TOKEN ─────────────
// Per-user opaque tokens used by the MT4/MT5 Expert Advisor (and any custom
// bot or TradingView webhook) to post trade fills directly to the journal
// without needing a session cookie. One active token per user is enough for
// the launch; rotation comes later.
model JournalSyncToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  token       String    @unique
  label       String?   // optional human-readable label e.g. "My MT4"
  lastUsedAt  DateTime? @map("last_used_at")
  fillsCount  Int       @default(0) @map("fills_count")
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("journal_sync_tokens")
}

// ───────────── BROKERS ─────────────
model BrokerConnection {
  id                 String     @id @default(uuid())
  userId             String     @map("user_id")
  brokerName         BrokerName @map("broker_name")
  apiKeyEncrypted    String?    @map("api_key_encrypted") @db.Text
  apiSecretEncrypted String?    @map("api_secret_encrypted") @db.Text
  accountId          String?    @map("account_id")
  environment        String?    @default("live") @map("environment") // "live" | "practice" — for OANDA
  isConnected        Boolean    @default(true) @map("is_connected")
  lastSyncedAt       DateTime?  @map("last_synced_at")
  lastSyncError      String?    @map("last_sync_error") @db.Text
  createdAt          DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("broker_connections")
}

model Position {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  brokerName   String    @map("broker_name")
  symbol       String
  direction    Direction
  size         Decimal   @db.Decimal(15, 4)
  entryPrice   Decimal   @map("entry_price") @db.Decimal(15, 5)
  currentPrice Decimal?  @map("current_price") @db.Decimal(15, 5)
  pnl          Decimal?  @db.Decimal(15, 2)
  stopLoss     Decimal?  @map("stop_loss") @db.Decimal(15, 5)
  takeProfit   Decimal?  @map("take_profit") @db.Decimal(15, 5)
  openedAt     DateTime  @map("opened_at")
  syncedAt     DateTime  @default(now()) @map("synced_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([symbol])
  @@map("positions")
}

// ───────────── JOURNAL ─────────────
model Trade {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  symbol      String
  direction   Direction
  size        Decimal   @db.Decimal(15, 4)
  entryPrice  Decimal   @map("entry_price") @db.Decimal(15, 5)
  exitPrice   Decimal?  @map("exit_price") @db.Decimal(15, 5)
  stopLoss    Decimal?  @map("stop_loss") @db.Decimal(15, 5)
  takeProfit  Decimal?  @map("take_profit") @db.Decimal(15, 5)
  pnl         Decimal?  @db.Decimal(15, 2)
  pnlR        Decimal?  @map("pnl_r") @db.Decimal(6, 2) // R-multiple
  setupType   String?   @map("setup_type") // 'news_trade' | 'ai_playbook' | 'sr_level' etc
  broker      String?
  notes       String?   @db.Text
  aiScore     Int?      @map("ai_score") // 0-100
  openedAt    DateTime  @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@index([userId])
  @@index([userId, openedAt])
  @@map("trades")
}

model JournalEntry {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  entryType JournalEntryType @map("entry_type")
  content   String           @db.Text
  tradeId   String?          @map("trade_id")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade Trade? @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("journal_entries")
}

// ───────────── NEWS + PLAYBOOKS ─────────────
model NewsStory {
  id              String   @id @default(uuid())
  finnhubId       String   @unique @map("finnhub_id")
  headline        String   @db.Text
  summary         String?  @db.Text
  source          String?
  url             String?  @db.Text
  bias            Bias?
  impact          Impact?
  isBreaking      Boolean  @default(false) @map("is_breaking")
  affectedAssets  String[] @map("affected_assets")
  // Richer per-asset detail: [{ symbol, direction, expectedMovePct, rationale }]
  affectedMarkets Json?    @map("affected_markets")
  reasoning       String?  @db.Text
  publishedAt     DateTime @map("published_at")
  scoredAt        DateTime @default(now()) @map("scored_at")

  playbooks Playbook[]

  @@index([publishedAt])
  @@index([isBreaking])
  @@map("news_stories")
}

model Playbook {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  symbol      String
  newsId      String?  @map("news_id")
  bias        Bias
  confidence  Impact
  bullEntry   Decimal? @map("bull_entry") @db.Decimal(15, 5)
  bullTp      Decimal? @map("bull_tp") @db.Decimal(15, 5)
  bullSl      Decimal? @map("bull_sl") @db.Decimal(15, 5)
  bearEntry   Decimal? @map("bear_entry") @db.Decimal(15, 5)
  bearTp      Decimal? @map("bear_tp") @db.Decimal(15, 5)
  bearSl      Decimal? @map("bear_sl") @db.Decimal(15, 5)
  reasoning   String?  @db.Text
  keyLevels   String[] @map("key_levels")
  generatedAt DateTime @default(now()) @map("generated_at")

  user User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  news NewsStory? @relation(fields: [newsId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([symbol])
  @@map("playbooks")
}

// ───────────── WATCHLIST + ALERTS ─────────────
model WatchlistItem {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  symbol  String
  addedAt DateTime @default(now()) @map("added_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
  @@map("watchlist")
}

model Alert {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  symbol      String
  condition   AlertCondition
  price       Decimal        @db.Decimal(15, 5)
  triggered   Boolean        @default(false)
  triggeredAt DateTime?      @map("triggered_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([symbol, triggered])
  @@map("alerts")
}

// ───────────── FUNDED ACCOUNTS ─────────────
model FundedAccount {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  firmName              String   @map("firm_name") // 'ftmo' | 'the5ers' | 'topstep'
  accountSize           Decimal  @map("account_size") @db.Decimal(15, 2)
  profitTargetPct       Decimal  @map("profit_target_pct") @db.Decimal(5, 2)
  dailyLossLimitPct     Decimal  @map("daily_loss_limit_pct") @db.Decimal(5, 2)
  maxDrawdownPct        Decimal  @map("max_drawdown_pct") @db.Decimal(5, 2)
  currentProfitPct      Decimal? @map("current_profit_pct") @db.Decimal(5, 2)
  currentDailyLossPct   Decimal? @map("current_daily_loss_pct") @db.Decimal(5, 2)
  phase                 String? // 'Phase 1' | 'Phase 2' | 'Funded'
  startDate             DateTime? @map("start_date") @db.Date
  endDate               DateTime? @map("end_date") @db.Date
  isActive              Boolean  @default(true) @map("is_active")
  updatedAt             DateTime @updatedAt @map("updated_at")
  createdAt             DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("funded_accounts")
}

// ───────────── BROKER AFFILIATE CLICK TRACKING ─────────────
// Every click on the "Open in [Broker]" / MT5 / prop-firm CTAs is logged so
// we can attribute conversions, run weekly revenue reports, and split-test
// CTA copy. brokerId may be 'mt4'/'mt5' for MetaTrader launcher hits.
model BrokerClick {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")          // null when user not signed in
  brokerId     String   @map("broker_id")        // matches RegulatedBroker.id
  symbol       String?                            // active chart symbol at click time
  surface      String?                            // 'dropdown' | 'mt-launcher' | 'prop-page' | etc.
  affiliateRef String?  @map("affiliate_ref")    // ref code substituted into URL, if any
  ip           String?                            // for crude dedupe + abuse signal
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([brokerId, createdAt])
  @@index([userId])
  @@map("broker_clicks")
}

// ───────────── ONBOARDING / PERSONALISATION ─────────────
// Captured by the first-load wizard. Used to seed Claude prompts (so the AI
// playbook + bias commentary speak to *this* trader's style, account size,
// and instruments) and to drive the leaderboard / ideas filtering.
model UserProfile {
  userId          String   @id @map("user_id")
  experience      String?                            // 'beginner' | 'intermediate' | 'advanced'
  style           String?                            // 'scalper' | 'day-trader' | 'swing' | 'position'
  accountSize     Decimal? @map("account_size") @db.Decimal(15, 2)
  riskPctPerTrade Decimal? @map("risk_pct_per_trade") @db.Decimal(5, 2)
  primaryAssets   String[] @map("primary_assets")    // ['XAU/USD', 'BTC/USD', ...]
  sessions        String[]                            // ['london', 'ny']
  goals           String?                             // 'pass-prop-firm' | 'income' | 'wealth'
  propFirm        String?  @map("prop_firm")          // 'ftmo' | 'topstep' | null
  completedAt     DateTime? @map("completed_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ───────────── AI CHAT (per chart) ─────────────
// One row per turn. Sessions are bucketed by symbol so history scopes to the
// active chart. Stored so we can rehydrate the side panel + measure usage.
model AiChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  symbol    String                                    // 'XAU/USD' etc.
  role      String                                    // 'user' | 'assistant'
  content   String   @db.Text
  ctxNewsIds String[] @map("ctx_news_ids")            // news headlines we injected as context
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol, createdAt])
  @@map("ai_chat_messages")
}

// ───────────── BIAS OUTCOMES (track record) ─────────────
// Snapshot of every bias generation + the actual price move N hours later.
// Powers the public /track-record page (hit rate, avg R, P&L curve).
model BiasOutcome {
  id            String   @id @default(uuid())
  symbol        String
  bias          String                                 // 'bullish' | 'bearish' | 'neutral'
  source        String                                 // 'fundamental' | 'technical' | 'dayTrade' | 'swingTrade'
  generatedAt   DateTime @map("generated_at")
  priceAtGen    Decimal  @map("price_at_gen") @db.Decimal(18, 6)
  priceAfter1h  Decimal? @map("price_after_1h") @db.Decimal(18, 6)
  priceAfter4h  Decimal? @map("price_after_4h") @db.Decimal(18, 6)
  priceAfter24h Decimal? @map("price_after_24h") @db.Decimal(18, 6)
  hit1h         Boolean? @map("hit_1h")                // direction matched after 1h?
  hit4h         Boolean? @map("hit_4h")
  hit24h        Boolean? @map("hit_24h")
  rationale     String?  @db.Text

  @@index([symbol, generatedAt])
  @@index([source, generatedAt])
  @@map("bias_outcomes")
}

// ───────────── BLOG / DAILY MARKET WRAP ─────────────
// Cron job calls Claude every weekday at 06:00 UTC to generate the day-ahead
// wrap. Indexed pages = SEO oxygen. Slug is used for /blog/{slug} routes.
model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  body        String   @db.Text
  tags        String[]
  symbols     String[]                                // ['EUR/USD', 'XAU/USD'] for cross-linking
  kind        String                                  // 'market-wrap' | 'analysis' | 'education'
  published   Boolean  @default(true)
  publishedAt DateTime @default(now()) @map("published_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([published, publishedAt])
  @@map("blog_posts")
}

// ───────────── TRADE IDEAS / LEADERBOARD ─────────────
// Users post setups; system tracks SL/TP hits to compute a public win-rate.
// Stops the platform feeling lonely on day one and builds network effects.
model TradeIdea {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  symbol      String
  direction   String                                  // 'long' | 'short'
  entry       Decimal  @db.Decimal(18, 6)
  stopLoss    Decimal  @map("stop_loss") @db.Decimal(18, 6)
  takeProfit  Decimal  @map("take_profit") @db.Decimal(18, 6)
  thesis      String   @db.Text
  outcome     String?                                 // 'win' | 'loss' | 'breakeven' | null=open
  rR          Decimal? @map("r_r") @db.Decimal(5, 2)
  closedAt    DateTime? @map("closed_at")
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([outcome, createdAt])
  @@map("trade_ideas")
}
