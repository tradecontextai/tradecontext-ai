# ════════════ TradeContext.ai server env ════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ──── Server ────
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:8765

# ──── Auth ────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_random_64_byte_hex
JWT_EXPIRES_IN=7d

# 32-char (256-bit) key for AES encryption of broker API credentials
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_random_32_byte_hex

# ──── Database (PostgreSQL) ────
# Supabase free tier works. Connection string format:
#   postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://user:pass@localhost:5432/tradecontext

# ──── Stripe ────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring tiers
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_ELITE_MONTHLY_PRICE_ID=price_...
STRIPE_ELITE_ANNUAL_PRICE_ID=price_...
# One-time $799 lifetime — create a "One-time" Stripe product+price and
# paste the ID here. Backend uses mode='payment' (not 'subscription') for it.
STRIPE_LIFETIME_PRICE_ID=price_...

# ──── Broker affiliate codes (optional) ────
# Sign up to each broker's IB program, paste the referral code below.
# Without these the dropdown still works — we just don't earn the CPA.
# Pattern: BROKER_AFFILIATE_<BROKER_ID_UPPERCASE>
# BROKER_AFFILIATE_OANDA=12345
# BROKER_AFFILIATE_PEPPERSTONE=AMIR
# BROKER_AFFILIATE_ICMARKETS=98765
# BROKER_AFFILIATE_VANTAGE=VTC123
# Coverage report: GET /api/brokers/affiliate-coverage

# ──── Anthropic (Claude API) ────
ANTHROPIC_API_KEY=sk-ant-...

# ──── Finnhub (news + prices) ────
FINNHUB_API_KEY=

# ──── Email (Resend) ────
RESEND_API_KEY=re_...
FROM_EMAIL=hello@tradecontext.ai

# ──── OANDA ────
OANDA_API_URL=https://api-fxtrade.oanda.com
